#!/bin/sh
python=$(git config --get keshig.python)
if [ -n "$python" ]; then
    exec "$python" -B tools/privacy_check.py --mode history --pre-push
fi
for python in python3 python; do
    if command -v "$python" >/dev/null 2>&1; then
        exec "$python" -B tools/privacy_check.py --mode history --pre-push
    fi
done
echo "Keshig: run tools/setup_dev.py with your Python interpreter first." >&2
exit 1
